{
	"compilerOptions": {
		"target": "ES2021",
		"lib": ["ES2022"],
		"module": "node20",
		"types": ["node"],
		"strict": true,
		"declaration": true,
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "out",
		"rootDir": "src"
	},
	"include": ["src"]
}
