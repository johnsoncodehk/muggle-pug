{
	"name": "muggle-pug",
	"version": "0.1.0-alpha.0",
	"description": "Pug compiled to HTML as pieces that map to the pug code",
	"type": "module",
	"exports": {
		".": {
			"types": "./out/index.d.ts",
			"default": "./out/index.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"license": "MIT",
	"files": [
		"out/**/*.js",
		"out/**/*.d.ts"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/johnsoncodehk/muggle-pug.git"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run"
	},
	"dependencies": {
		"muggle-string": "^1.0.0",
		"pug-lexer": "^5.0.1",
		"pug-parser": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"typescript": "7.1.0-beta",
		"vitest": "latest"
	}
}
